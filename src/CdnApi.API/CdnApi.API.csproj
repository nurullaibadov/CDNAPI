<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>cdnapi-user-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.7.3" />

    <!-- JWT Auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />

    <!-- Rate Limiting is built into ASP.NET Core 8 — no separate NuGet needed -->

    <!-- AutoMapper 13 has built-in DI support — Extensions package not needed and causes ambiguity -->
    <PackageReference Include="AutoMapper" Version="13.0.1" />

    <!-- EF Core (for design-time migrations) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CdnApi.Application\CdnApi.Application.csproj" />
    <ProjectReference Include="..\CdnApi.Infrastructure\CdnApi.Infrastructure.csproj" />
  </ItemGroup>
</Project>
